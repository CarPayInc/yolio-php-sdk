{
    "name": "messaging-hub/sdk",
    "description": "PHP SDK for the Messaging Hub API",
    "license": "proprietary",
    "version": "1.0.0",
    "type": "library",
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "MessagingHub\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MessagingHub\\Sdk\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
