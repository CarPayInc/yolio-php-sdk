{
    "name": "yolio/sdk",
    "description": "PHP SDK for the Yolio API",
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/CarPayInc/yolio-php-sdk",
    "keywords": [
        "yolio",
        "sdk",
        "messaging",
        "email",
        "sms",
        "notifications",
        "api-client"
    ],
    "authors": [
        {
            "name": "CarPay, Inc.",
            "homepage": "https://github.com/CarPayInc"
        }
    ],
    "support": {
        "issues": "https://github.com/CarPayInc/yolio-php-sdk/issues",
        "source": "https://github.com/CarPayInc/yolio-php-sdk"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Yolio\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yolio\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "cooldown": {
                "period": "3 days"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
